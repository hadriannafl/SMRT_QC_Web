@{
    ViewData["Title"] = "Quality Report";
    var records = ViewBag.Records as List<SMRT_QC_Web.Models.InspectionRecord>;
    bool hasData = records != null && records.Any();
}

<div class="space-y-5">

    <!-- Header -->
    <div class="flex items-center justify-between no-print">
        <div>
            <h2 class="text-xl font-bold text-gray-900">Quality Report</h2>
            <p class="text-sm text-gray-500">Laporan hasil inspeksi — bisa dicetak / disimpan PDF</p>
        </div>
        @if (hasData)
        {
            <button onclick="window.print()" class="btn btn-primary">
                🖨️ Print / Simpan PDF
            </button>
        }
    </div>

    <!-- ── Filter Form ─────────────────────────────────────────── -->
    <div class="card no-print">
        <div class="card-header">🔍 Filter Laporan</div>
        <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="form-group">
                <label class="form-label">Supply Number</label>
                <input name="supplyNumber" class="form-input" placeholder="Kosongkan = semua"
                       value="@ViewBag.SupplyNumber" />
            </div>
            <div class="form-group">
                <label class="form-label">Part Number</label>
                <input name="partNumber" class="form-input" placeholder="Kosongkan = semua"
                       value="@ViewBag.PartFilter" />
            </div>
            <div class="form-group">
                <label class="form-label">Dari Tanggal</label>
                <input name="dateFrom" type="date" class="form-input" value="@ViewBag.DateFrom" />
            </div>
            <div class="form-group">
                <label class="form-label">Sampai Tanggal</label>
                <input name="dateTo" type="date" class="form-input" value="@ViewBag.DateTo" />
            </div>
            <div class="col-span-full flex gap-3">
                <button type="submit" class="btn btn-blue">Tampilkan Laporan</button>
                <a href="@Url.Action("Index","Reports")" class="btn btn-outline">Reset</a>
            </div>
        </form>
    </div>

    @if (hasData)
    {
        <!-- ── Printable Report Section ─────────────────────────── -->
        <div id="print-section" class="space-y-5">

            <!-- Report Header (tampil di print) -->
            <div class="card">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-widest">PT. Sakai Indonesia</p>
                        <h1 class="text-2xl font-bold text-[#1A237E] mt-1">SMART IQC — Inspection Report</h1>
                        <p class="text-sm text-gray-500 mt-1">Dicetak: @DateTime.Now.ToString("dd MMMM yyyy HH:mm")</p>
                    </div>
                    <div class="text-right text-sm text-gray-500">
                        @if (!string.IsNullOrEmpty(ViewBag.SupplyNumber?.ToString()))
                        {
                            <p>Supply: <strong class="text-gray-900">@ViewBag.SupplyNumber</strong></p>
                        }
                        <p>Total Data: <strong class="text-gray-900">@records!.Count</strong></p>
                        <p>Status DONE: <strong class="text-green-600">@records!.Count(r => r.NcnStatus == "DONE")</strong></p>
                        <p>Ada NCN: <strong class="text-red-600">@records!.Count(r => !string.IsNullOrEmpty(r.NcnNo))</strong></p>
                    </div>
                </div>
            </div>

            <!-- Summary Stats -->
            <div class="grid grid-cols-4 gap-4">
                @{
                    var done       = records!.Count(r => r.NcnStatus == "DONE");
                    var pending    = records.Count(r => r.NcnStatus != "DONE");
                    var withNcn    = records.Count(r => !string.IsNullOrEmpty(r.NcnNo));
                    var passRate   = records.Count > 0 ? (done * 100.0 / records.Count) : 0;
                }
                <div class="card text-center py-3">
                    <p class="text-2xl font-bold text-green-600">@done</p>
                    <p class="text-xs text-gray-500 mt-1">DONE</p>
                </div>
                <div class="card text-center py-3">
                    <p class="text-2xl font-bold text-yellow-600">@pending</p>
                    <p class="text-xs text-gray-500 mt-1">Belum Selesai</p>
                </div>
                <div class="card text-center py-3">
                    <p class="text-2xl font-bold text-red-600">@withNcn</p>
                    <p class="text-xs text-gray-500 mt-1">Ada NCN</p>
                </div>
                <div class="card text-center py-3">
                    <p class="text-2xl font-bold text-[#1A237E]">@passRate.ToString("F1")%</p>
                    <p class="text-xs text-gray-500 mt-1">Pass Rate</p>
                </div>
            </div>

            <!-- Detail Table -->
            <div class="card p-0 overflow-hidden">
                <table class="tbl" style="font-size:0.8rem">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Supply No</th>
                            <th>Part No</th>
                            <th>PO No</th>
                            <th>Operator</th>
                            <th>Checker</th>
                            <th>Approver</th>
                            <th>NCN No</th>
                            <th>Status</th>
                            <th>Validasi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < records!.Count; i++)
                        {
                            var r = records[i];
                            <tr>
                                <td class="text-center text-gray-400">@(i + 1)</td>
                                <td class="font-mono">@r.SupplyNumber</td>
                                <td class="font-mono">@(r.PartNumber ?? "—")</td>
                                <td>@(r.PoNumber ?? "—")</td>
                                <td>@(r.Operator ?? "—")</td>
                                <td>@(r.ChekName ?? "—")</td>
                                <td>@(r.AppvName ?? "—")</td>
                                <td class="font-mono text-red-600">@(r.NcnNo ?? "—")</td>
                                <td><span class="badge @r.StatusBadgeClass">@r.NcnStatus</span></td>
                                <td>@(r.Validasi ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Signature area (untuk print) -->
            <div class="card">
                <div class="grid grid-cols-3 gap-8 text-center">
                    <div>
                        <p class="text-xs text-gray-500 mb-16">Dibuat oleh</p>
                        <div class="border-t border-gray-400 pt-2">
                            <p class="text-sm font-medium text-gray-700">( @User.Identity?.Name )</p>
                            <p class="text-xs text-gray-500">QC Staff</p>
                        </div>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-16">Diperiksa oleh</p>
                        <div class="border-t border-gray-400 pt-2">
                            <p class="text-sm font-medium text-gray-700">( ................................ )</p>
                            <p class="text-xs text-gray-500">Supervisor</p>
                        </div>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-16">Disetujui oleh</p>
                        <div class="border-t border-gray-400 pt-2">
                            <p class="text-sm font-medium text-gray-700">( ................................ )</p>
                            <p class="text-xs text-gray-500">Manager</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (ViewBag.SupplyNumber != null || ViewBag.DateFrom != null)
    {
        <div class="card text-center py-12 text-gray-400">
            <p class="text-4xl mb-3">🔍</p>
            <p class="font-medium">Tidak ada data untuk filter yang dipilih.</p>
        </div>
    }
    else
    {
        <div class="card text-center py-12 text-gray-400">
            <p class="text-4xl mb-3">📋</p>
            <p class="font-medium">Pilih filter di atas untuk menampilkan laporan.</p>
        </div>
    }
</div>
