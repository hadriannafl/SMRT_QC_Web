@{
    ViewData["Title"] = "Quality Report";
    var parts = (ViewBag.Parts as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
}

<div class="space-y-6">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-gray-900">Quality Report</h2>
            <p class="text-sm text-gray-500 mt-0.5">Generate laporan inspeksi, NCN, dan ringkasan kualitas</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-gray-400">
            <svg style="width:16px;height:16px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>@DateTime.Now.ToString("dd MMMM yyyy")</span>
        </div>
    </div>

    <!-- Report Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3" style="gap:1.75rem">

        <!-- ── Card 1: Inspection Report ─────────────────────────── -->
        <div class="card flex flex-col">
            <div class="flex items-center gap-3 mb-5">
                <div style="width:44px;height:44px;border-radius:0.75rem;background:#eef2ff;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <svg style="width:20px;height:20px" class="text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900">Inspection Report</h3>
                    <p class="text-xs text-gray-500">Data hasil inspeksi QC per supply</p>
                </div>
            </div>

            <form method="get" action="@Url.Action("InspectionReport","Report")"
                  target="_blank" class="flex flex-col flex-1 gap-3">
                <div class="grid grid-cols-2 gap-3">
                    <div class="form-group mb-0">
                        <label class="form-label">Dari Tanggal</label>
                        <input name="dateFrom" type="date" class="form-input"
                               value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Sampai Tanggal</label>
                        <input name="dateTo" type="date" class="form-input"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Part Number</label>
                    <select name="partNumber" class="form-input">
                        <option value="">— Semua Part —</option>
                        @foreach (var p in parts)
                        {
                            <option value="@p.PartNumber">@p.PartNumber — @p.PartName</option>
                        }
                    </select>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-input">
                        <option value="">— Semua Status —</option>
                        <option value="CHECK">CHECK</option>
                        <option value="VALIDATION">VALIDATION</option>
                        <option value="MAKE NCN">MAKE NCN</option>
                        <option value="DONE">DONE</option>
                    </select>
                </div>
                <div class="mt-auto pt-2">
                    <button type="submit" class="btn btn-primary w-full justify-center">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        Generate Inspection Report
                    </button>
                </div>
            </form>
        </div>

        <!-- ── Card 2: NCN Report ─────────────────────────────────── -->
        <div class="card flex flex-col">
            <div class="flex items-center gap-3 mb-5">
                <div style="width:44px;height:44px;border-radius:0.75rem;background:#fef2f2;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <svg style="width:20px;height:20px" class="text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900">NCN Report</h3>
                    <p class="text-xs text-gray-500">Non-Conformance Notice per part &amp; defect</p>
                </div>
            </div>

            <form method="get" action="@Url.Action("NcnReport","Report")"
                  target="_blank" class="flex flex-col flex-1 gap-3">
                <div class="grid grid-cols-2 gap-3">
                    <div class="form-group mb-0">
                        <label class="form-label">Dari Tanggal</label>
                        <input name="dateFrom" type="date" class="form-input"
                               value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Sampai Tanggal</label>
                        <input name="dateTo" type="date" class="form-input"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Part Number</label>
                    <select name="partNumber" class="form-input">
                        <option value="">— Semua Part —</option>
                        @foreach (var p in parts)
                        {
                            <option value="@p.PartNumber">@p.PartNumber — @p.PartName</option>
                        }
                    </select>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Status NCN</label>
                    <select name="status" class="form-input">
                        <option value="">— Semua Status —</option>
                        <option value="CHECK">CHECK</option>
                        <option value="PROCESS">PROCESS</option>
                        <option value="DONE">DONE</option>
                    </select>
                </div>
                <div class="mt-auto pt-2">
                    <button type="submit" class="btn btn-danger w-full justify-center">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        Generate NCN Report
                    </button>
                </div>
            </form>
        </div>

        <!-- ── Card 3: Quality Summary ────────────────────────────── -->
        <div class="card flex flex-col">
            <div class="flex items-center gap-3 mb-5">
                <div style="width:44px;height:44px;border-radius:0.75rem;background:#ecfdf5;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <svg style="width:20px;height:20px" class="text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900">Quality Summary</h3>
                    <p class="text-xs text-gray-500">Analitik & ringkasan data kualitas</p>
                </div>
            </div>

            <form method="get" action="@Url.Action("QualityData","Report")"
                  target="_blank" class="flex flex-col flex-1 gap-3">
                <div class="grid grid-cols-2 gap-3">
                    <div class="form-group mb-0">
                        <label class="form-label">Dari Tanggal</label>
                        <input name="dateFrom" type="date" class="form-input"
                               value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Sampai Tanggal</label>
                        <input name="dateTo" type="date" class="form-input"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="card mt-2 py-4 bg-emerald-50 border border-emerald-100">
                    <p class="text-xs text-emerald-700 font-semibold mb-2">Laporan ini mencakup:</p>
                    <ul class="text-xs text-emerald-600 space-y-1">
                        <li class="flex items-center gap-1.5">
                            <span style="font-size:10px;font-weight:700;color:#059669">✓</span>
                            Ringkasan status inspeksi
                        </li>
                        <li class="flex items-center gap-1.5">
                            <span style="font-size:10px;font-weight:700;color:#059669">✓</span>
                            NCN per part number
                        </li>
                        <li class="flex items-center gap-1.5">
                            <span style="font-size:10px;font-weight:700;color:#059669">✓</span>
                            Top defect types
                        </li>
                    </ul>
                </div>

                <div class="mt-auto pt-2">
                    <button type="submit" class="btn btn-success w-full justify-center">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        Generate Quality Summary
                    </button>
                </div>
            </form>
        </div>

    </div>

    <!-- Info tip -->
    <div class="flex items-center gap-3 bg-blue-50 border border-blue-100 rounded-xl px-4 py-3 text-sm text-blue-700">
        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Laporan akan dibuka di tab baru. Gunakan <strong class="mx-1">Ctrl+P</strong> atau tombol <strong class="ml-1">Print</strong> di halaman laporan untuk menyimpan sebagai PDF.
    </div>

</div>
