@* Notification dropdown partial — rendered inside the notificationDropdown Alpine component *@
@* This partial is included inside the bell button's parent x-data scope *@

<div x-show="open"
     @@click.outside="open = false"
     x-transition:enter="transition ease-out duration-150"
     x-transition:enter-start="opacity-0 translate-y-1"
     x-transition:enter-end="opacity-100 translate-y-0"
     x-transition:leave="transition ease-in duration-100"
     x-transition:leave-start="opacity-100 translate-y-0"
     x-transition:leave-end="opacity-0 translate-y-1"
     class="absolute right-0 top-full mt-2 w-80 bg-white rounded-xl shadow-xl border border-gray-100 overflow-hidden z-50"
     style="display:none;">

    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 bg-[#1A237E]">
        <h3 class="text-sm font-semibold text-white">Notifikasi</h3>
        <button @@click="markAllRead()"
                class="text-xs text-blue-200 hover:text-white transition-colors">
            Tandai semua dibaca
        </button>
    </div>

    <!-- Notification list -->
    <div class="max-h-80 overflow-y-auto divide-y divide-gray-50">
        <template x-if="notifications.length === 0">
            <div class="flex flex-col items-center justify-center py-8 text-gray-400">
                <svg class="w-10 h-10 mb-2 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
                <p class="text-sm">Tidak ada notifikasi baru</p>
            </div>
        </template>

        <template x-for="notif in notifications" :key="notif.id">
            <div class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 transition-colors cursor-pointer"
                 @@click="markRead(notif.id)">
                <!-- Icon dot -->
                <div class="w-2 h-2 rounded-full bg-[#1A237E] mt-2 shrink-0"></div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm text-gray-800 line-clamp-2" x-text="notif.notif"></p>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="text-xs text-gray-400" x-text="notif.timeAgo"></span>
                        <span x-show="notif.partNumber"
                              class="text-xs bg-blue-50 text-blue-600 px-1.5 py-0.5 rounded"
                              x-text="notif.partNumber">
                        </span>
                    </div>
                </div>
                <!-- Dismiss -->
                <button @@click.stop="markRead(notif.id)"
                        class="text-gray-300 hover:text-gray-500 shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </button>
            </div>
        </template>
    </div>

    <!-- Footer -->
    <div class="px-4 py-2.5 bg-gray-50 border-t border-gray-100">
        <a href="@Url.Action("Index","Dashboard")"
           class="text-xs text-[#1A237E] font-medium hover:underline">
            Lihat semua aktivitas →
        </a>
    </div>
</div>
