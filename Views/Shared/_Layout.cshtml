<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SmartIQC</title>
    <!-- TailwindCSS — compiled locally (do not use CDN in production) -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <!-- Alpine.js — served locally (no external CDN request) -->
    <script defer src="~/js/alpine.min.js" asp-append-version="true"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <!-- SignalR client -->
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<!-- Use system font stack — no external font request needed -->
<body class="h-full bg-[#F5F6FA]" style="font-family:'Segoe UI',system-ui,-apple-system,sans-serif;">

<div class="flex h-full" x-data="appLayout()">

    <!-- ═══════════════════════════════════════════════════════════════════════
         LEFT SIDEBAR — Dark Navy (#1A237E), fixed 256px wide
    ════════════════════════════════════════════════════════════════════════ -->
    <aside class="fixed inset-y-0 left-0 z-30 w-64 bg-[#1A237E] flex flex-col shadow-2xl
                  transform transition-transform duration-200 ease-in-out"
           :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'">

        <!-- Logo / App name -->
        <div class="flex items-center gap-3 px-6 py-5 border-b border-white/10">
            <img src="~/images/sakailogo.png" alt="Sakai Logo" class="w-9 h-9 rounded-full object-cover shrink-0" />
            <div>
                <p class="text-white font-bold text-lg leading-none">SmartIQC</p>
                <p class="text-blue-200 text-xs mt-0.5">Quality Control System</p>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">

            <!-- GROUP: FILE -->
            <p class="px-3 py-1.5 text-[10px] uppercase tracking-widest text-blue-300/60 font-semibold">File</p>

            <a href="@Url.Action("Index","Dashboard")"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "sidebar-link-active" : "")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                <span>Dashboard</span>
            </a>

            @if (User.IsInRole("ADMIN"))
            {
                <a href="@Url.Action("Index","User")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197"/>
                    </svg>
                    <span>Manajemen User</span>
                </a>
            }

            @if (User.IsInRole("ADMIN") || User.IsInRole("MANAGER"))
            {
                <a href="@Url.Action("Index","Part")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Part" ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                    <span>Master Part</span>
                </a>
            }

            <!-- GROUP: INPUT -->
            <p class="px-3 py-1.5 mt-3 text-[10px] uppercase tracking-widest text-blue-300/60 font-semibold">Input</p>

            <a href="@Url.Action("Index","Inspection")"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inspection" ? "sidebar-link-active" : "")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                </svg>
                <span>Inspeksi</span>
            </a>

            <a href="@Url.Action("Index","Ncn")"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ncn" ? "sidebar-link-active" : "")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>NCN</span>
            </a>

            <!-- GROUP: REPORT -->
            <p class="px-3 py-1.5 mt-3 text-[10px] uppercase tracking-widest text-blue-300/60 font-semibold">Report</p>

            <a href="@Url.Action("Index","Report")"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "sidebar-link-active" : "")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Quality Report</span>
            </a>

            <!-- GROUP: DATA -->
            @if (User.IsInRole("ADMIN") || User.IsInRole("MANAGER"))
            {
                <p class="px-3 py-1.5 mt-3 text-[10px] uppercase tracking-widest text-blue-300/60 font-semibold">Data</p>

                <a href="@Url.Action("Index","ImportExport")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ImportExport" ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                    </svg>
                    <span>Import / Export</span>
                </a>
            }
        </nav>

        <!-- User info at bottom of sidebar -->
        <div class="px-4 py-4 border-t border-white/10">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-white font-semibold text-sm shrink-0">
                    @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-white text-sm font-medium truncate">@User.Identity?.Name</p>
                    <p class="text-blue-200 text-xs">@User.FindFirst("Position")?.Value</p>
                </div>
            </div>
            <!-- Logout form -->
            <form method="post" action="@Url.Action("Logout","Auth")" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-blue-200 hover:text-white hover:bg-white/10 text-sm transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Logout
                </button>
            </form>
        </div>
    </aside>

    <!-- Mobile sidebar overlay -->
    <div class="fixed inset-0 z-20 bg-black/50 lg:hidden"
         x-show="sidebarOpen"
         x-transition:enter="transition-opacity duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition-opacity duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @@click="sidebarOpen = false">
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN CONTENT AREA — offset by sidebar width on large screens
    ════════════════════════════════════════════════════════════════════════ -->
    <div class="flex-1 flex flex-col min-h-full lg:pl-64">

        <!-- ── TOP BAR ─────────────────────────────────────────────────────── -->
        <header class="sticky top-0 z-10 bg-white border-b border-gray-200 shadow-sm">
            <div class="flex items-center justify-between h-14 px-4 md:px-6">

                <!-- Hamburger for mobile -->
                <button @@click="sidebarOpen = !sidebarOpen"
                        class="lg:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>

                <!-- Page title -->
                <h1 class="text-base font-semibold text-gray-800 ml-2 lg:ml-0">@ViewData["Title"]</h1>

                <!-- Right side: notifications + user -->
                <div class="flex items-center gap-3">

                    <!-- Notification bell -->
                    <div class="relative" x-data="notificationDropdown()">
                        <button @@click="open = !open"
                                class="relative p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                            </svg>
                            <!-- Unread badge -->
                            <span x-show="unreadCount > 0"
                                  x-text="unreadCount > 9 ? '9+' : unreadCount"
                                  class="absolute -top-1 -right-1 min-w-[18px] h-[18px] bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center px-1">
                            </span>
                        </button>

                        @await Html.PartialAsync("_Notifications")
                    </div>

                    <!-- User avatar -->
                    <div class="w-8 h-8 rounded-full bg-[#1A237E] flex items-center justify-center text-white text-sm font-semibold">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                </div>
            </div>
        </header>

        <!-- ── PAGE CONTENT ────────────────────────────────────────────────── -->
        <main class="flex-1 p-4 md:p-6">
            <!-- Flash messages -->
            @if (TempData["Success"] != null)
            {
                <div class="mb-4 flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 rounded-xl px-4 py-3 text-sm"
                     x-data="{ show: true }" x-show="show">
                    <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>@TempData["Success"]</span>
                    <button @@click="show = false" class="ml-auto text-green-500 hover:text-green-700">✕</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-800 rounded-xl px-4 py-3 text-sm"
                     x-data="{ show: true }" x-show="show">
                    <svg class="w-4 h-4 text-red-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    <span>@TempData["Error"]</span>
                    <button @@click="show = false" class="ml-auto text-red-500 hover:text-red-700">✕</button>
                </div>
            }

            @RenderBody()
        </main>
    </div>
</div>

<!-- Toast notification container (for SignalR real-time toasts) -->
<div id="toast-container"
     class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"
     style="max-width:360px">
</div>

@await RenderSectionAsync("Scripts", required: false)

<script src="~/js/app.js" asp-append-version="true"></script>

<script>
    // ── Alpine component: app layout (sidebar toggle) ──────────────────────
    function appLayout() {
        return {
            sidebarOpen: false
        };
    }

    // ── Alpine component: notification dropdown ────────────────────────────
    function notificationDropdown() {
        return {
            open: false,
            unreadCount: 0,
            notifications: [],

            async init() {
                await this.fetchNotifications();
                // Poll every 30 seconds as backup to SignalR
                setInterval(() => this.fetchNotifications(), 30000);
            },

            async fetchNotifications() {
                try {
                    const res = await fetch('/Dashboard/Notifications');
                    const data = await res.json();
                    if (data.success) {
                        this.unreadCount = data.unreadCount;
                        this.notifications = data.data;
                    }
                } catch (e) {
                    console.warn('Could not fetch notifications:', e);
                }
            },

            async markRead(id) {
                await fetch('/Dashboard/MarkRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                    },
                    body: JSON.stringify({ id })
                });
                this.notifications = this.notifications.filter(n => n.id !== id);
                this.unreadCount = Math.max(0, this.unreadCount - 1);
            },

            async markAllRead() {
                await fetch('/Dashboard/MarkAllRead', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                    }
                });
                this.notifications = [];
                this.unreadCount = 0;
            }
        };
    }
</script>

</body>
</html>
